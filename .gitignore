# Bundled tracker binaries (OpenSeeFace / MediaPipe tracker; built or copied in locally, copied into builds)
/VRCast/Trackers/
# Old location (inside Assets; breaks Editor script compilation, kept ignored for existing checkouts)
/VRCast/Assets/StreamingAssets/OpenSeeFace/
/VRCast/Assets/StreamingAssets/OpenSeeFace.meta
/VRCast/Assets/StreamingAssets/MediaPipeTracker/
/VRCast/Assets/StreamingAssets/MediaPipeTracker.meta

# Virtual camera (UnityCapture; fetched by Tools/UnityCapture/fetch.ps1, shipped in builds)
/VRCast/Assets/StreamingAssets/UnityCapture/
/VRCast/Assets/StreamingAssets/UnityCapture.meta
/VRCast/Assets/Plugins/UnityCapture/
/VRCast/Assets/Plugins/UnityCapture.meta

# Distribution zips (Tools/Package/package.bat)
/dist/

# Python (MediaPipe tracker tool)
__pycache__/
*.pyc
/Tools/MediaPipeTracker/.venv/
/Tools/MediaPipeTracker/build/
/Tools/MediaPipeTracker/dist/
/Tools/MediaPipeTracker/*.spec

# IDE / solution files
/VRCast/.vs/
